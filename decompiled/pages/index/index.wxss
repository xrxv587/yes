.goods-card{background:#fff;border-radius:18rpx;-webkit-box-shadow:0 8rpx 26rpx rgba(42,40,32,.06);box-shadow:0 8rpx 26rpx rgba(42,40,32,.06);margin-bottom:16rpx;overflow:hidden;-webkit-transition:opacity .18s ease,-webkit-transform .18s ease;transition:opacity .18s ease,-webkit-transform .18s ease;transition:transform .18s ease,opacity .18s ease;transition:transform .18s ease,opacity .18s ease,-webkit-transform .18s ease;width:calc(50% - 6rpx)}
.goods-card--active{opacity:.86;-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}
.goods-card__image-wrap{background:#ebe9e2;height:164rpx;overflow:hidden;position:relative;width:100%}
.goods-card__image{height:100%;width:100%}
.goods-card__badge{background:#dced74;border-radius:20rpx;color:#263024;font-size:9rpx;font-weight:700;left:10rpx;padding:4rpx 8rpx;position:absolute;top:10rpx}
.goods-card__body{padding:13rpx 12rpx 15rpx}
.goods-card__name{-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#262622;display:-webkit-box;font-size:14rpx;font-weight:600;line-height:20rpx;min-height:40rpx;overflow:hidden;text-overflow:ellipsis}
.goods-card__price-row{margin-top:10rpx}
.goods-card__price,.goods-card__price-row{-ms-flex-align:baseline;-webkit-align-items:baseline;align-items:baseline;display:-webkit-flex;display:-ms-flexbox;display:flex}
.goods-card__price{color:#e65f3a;font-size:18rpx;font-weight:700}
.goods-card__currency{font-size:11rpx;margin-right:2rpx}
.goods-card__original{color:#aaa9a3;font-size:10rpx;margin-left:7rpx;text-decoration:line-through}
.home-page{background:#f5f4ef;color:#191916;min-height:100vh;padding:16rpx 16rpx 32rpx}
.home-hero,.home-page{-webkit-box-sizing:border-box;box-sizing:border-box}
.home-hero{background:#222b25;border-radius:24rpx;-webkit-box-shadow:0 18rpx 42rpx rgba(34,43,37,.18);box-shadow:0 18rpx 42rpx rgba(34,43,37,.18);color:#fff;height:184rpx;overflow:hidden;padding:27rpx 24rpx;position:relative}
.home-hero__eyebrow{color:hsla(0,0%,100%,.58);font-size:10rpx;font-weight:600;letter-spacing:3rpx;margin-bottom:26rpx;position:relative;z-index:1}
.home-hero__title{font-size:31rpx;font-weight:700;letter-spacing:2rpx;line-height:1.2;margin-bottom:10rpx;position:relative;z-index:1}
.home-hero__subtitle{color:hsla(0,0%,100%,.66);font-size:13rpx;letter-spacing:1rpx;position:relative;z-index:1}
.home-hero__decoration{border:1rpx solid hsla(0,0%,100%,.16);border-radius:50%;position:absolute}
.home-hero__decoration--one{background:hsla(67,69%,67%,.08);height:168rpx;right:-20rpx;top:-45rpx;width:168rpx}
.home-hero__decoration--two{background:hsla(0,0%,100%,.04);bottom:-52rpx;height:108rpx;right:56rpx;width:108rpx}
.home-section-heading{-ms-flex-align:end;-ms-flex-pack:justify;-webkit-align-items:flex-end;align-items:flex-end;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;justify-content:space-between;padding:30rpx 4rpx 18rpx}
.home-section-heading__title{font-size:21rpx;font-weight:700;line-height:1.2;margin-bottom:5rpx}
.home-section-heading__count,.home-section-heading__subtitle{color:#8a8982;font-size:11rpx}
.home-section-heading__count{padding-bottom:1rpx}
.home-goods-list{-ms-flex-pack:justify;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;-webkit-justify-content:space-between;justify-content:space-between}
