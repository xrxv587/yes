.goods-detail{background:#f5f4ef;-webkit-box-sizing:border-box;box-sizing:border-box;color:#1d1d19;min-height:100vh;padding:14rpx 16rpx 126rpx}
.goods-detail__image-card{background:#e7e5dd;border-radius:28rpx;-webkit-box-shadow:0 20rpx 50rpx rgba(40,39,33,.1);box-shadow:0 20rpx 50rpx rgba(40,39,33,.1);height:382rpx;overflow:hidden;position:relative;width:100%}
.goods-detail__image{height:100%;width:100%}
.goods-detail__image-label{background:rgba(29,29,25,.36);border:1rpx solid hsla(0,0%,100%,.52);border-radius:20rpx;color:#fff;font-size:8rpx;font-weight:600;left:18rpx;letter-spacing:1.5rpx;padding:7rpx 11rpx;position:absolute;top:18rpx}
.goods-detail__content{padding:26rpx 6rpx 0}
.goods-detail__name{border-bottom:1rpx solid #deddd6;font-size:24rpx;font-weight:700;letter-spacing:0.3rpx;line-height:34rpx;padding-bottom:24rpx}
.goods-detail__price-row{-ms-flex-align:end;-webkit-align-items:flex-end;align-items:flex-end;border-bottom:1rpx solid #deddd6;display:-webkit-flex;display:-ms-flexbox;display:flex;padding:22rpx 0 23rpx;position:relative}
.goods-detail__meta-label{color:#929087;font-size:11rpx;margin-bottom:7rpx}
.goods-detail__price{-ms-flex-align:baseline;-webkit-align-items:baseline;align-items:baseline;color:#e65f3a;display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:30rpx;font-weight:750;line-height:1}
.goods-detail__currency{font-size:15rpx;margin-right:3rpx}
.goods-detail__original-wrap{margin-left:31rpx;padding-bottom:2rpx}
.goods-detail__original{color:#4d4c47;font-size:14rpx}
.goods-detail__original--discounted{color:#a4a29a;text-decoration:line-through}
.goods-detail__discount-tag{background:#e8efba;border-radius:7rpx;bottom:24rpx;color:#445026;font-size:10rpx;font-weight:600;padding:6rpx 9rpx;position:absolute;right:0}
.goods-detail__stock-row{padding:22rpx 0}
.goods-detail__stock-icon,.goods-detail__stock-row{-ms-flex-align:center;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex}
.goods-detail__stock-icon{-ms-flex-pack:center;background:#e5ebd2;border-radius:13rpx;height:38rpx;-webkit-justify-content:center;justify-content:center;margin-right:12rpx;width:38rpx}
.goods-detail__stock-dot{border:3rpx solid #81914d;border-radius:50%;height:8rpx;width:8rpx}
.goods-detail__stock-copy{-webkit-flex:1;-ms-flex:1;flex:1}
.goods-detail__stock-title{font-size:14rpx;font-weight:650;margin-bottom:3rpx}
.goods-detail__stock-subtitle{color:#95938b;font-size:11rpx}
.goods-detail__stock-value{border:1rpx solid #d8d6cd;border-radius:20rpx;color:#727168;font-size:10rpx;padding:5rpx 10rpx}
.goods-detail__footer{-ms-flex-align:center;-webkit-align-items:center;align-items:center;background:hsla(0,0%,100%,.96);bottom:0;-webkit-box-shadow:0 -12rpx 34rpx rgba(40,39,33,.08);box-shadow:0 -12rpx 34rpx rgba(40,39,33,.08);display:-webkit-flex;display:-ms-flexbox;display:flex;left:0;padding:12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:10}
.goods-detail__footer-copy{-webkit-flex:1;-ms-flex:1;flex:1;padding-left:6rpx}
.goods-detail__footer-label{color:#96948d;font-size:10rpx;margin-bottom:3rpx}
.goods-detail__footer-price{color:#e65f3a;font-size:20rpx;font-weight:700}
.goods-detail__buy-button{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:#222b25;border-radius:18rpx;-webkit-box-shadow:0 10rpx 24rpx rgba(34,43,37,.22);box-shadow:0 10rpx 24rpx rgba(34,43,37,.22);color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:15rpx;font-weight:650;height:54rpx;-webkit-justify-content:center;justify-content:center;letter-spacing:1rpx;-webkit-transition:opacity .18s ease,-webkit-transform .18s ease;transition:opacity .18s ease,-webkit-transform .18s ease;transition:transform .18s ease,opacity .18s ease;transition:transform .18s ease,opacity .18s ease,-webkit-transform .18s ease;width:174rpx}
.goods-detail__buy-button--active{opacity:.88;-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}
.goods-detail__buy-arrow{font-size:20rpx;font-weight:400;margin-left:18rpx}
.goods-detail--empty{-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;padding-bottom:80rpx}
.goods-detail--empty,.goods-detail__empty-mark{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:center;justify-content:center}
.goods-detail__empty-mark{background:#e2e0d6;border-radius:50%;color:#78766c;font-size:30rpx;height:66rpx;margin-bottom:16rpx;width:66rpx}
.goods-detail__empty-title{font-size:18rpx;font-weight:650;margin-bottom:20rpx}
.goods-detail__empty-action{background:#222b25;border-radius:24rpx;color:#fff;font-size:13rpx;padding:11rpx 22rpx}
